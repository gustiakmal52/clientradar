#!/bin/bash
# ==============================================================================
# ClientRadar — Developer Prospecting & Web Audit Engine
# Launcher: start / stop / status / restart / uninstall
# Author: Gustiakmal — v1.3.0
# ==============================================================================

set -euo pipefail

PROJECT_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
APP_HOST="${CLIENTRADAR_HOST:-127.0.0.1}"
BACKEND_PORT="${CLIENTRADAR_BACKEND_PORT:-8000}"
FRONTEND_PORT="${CLIENTRADAR_FRONTEND_PORT:-5173}"
PID_DIR="${XDG_RUNTIME_DIR:-/tmp}/clientradar"
BACKEND_PID_FILE="$PID_DIR/backend.pid"
FRONTEND_PID_FILE="$PID_DIR/frontend.pid"
LOG_DIR="$PROJECT_DIR/logs"

mkdir -p "$PID_DIR" "$LOG_DIR"

# Bersihkan semua proses saat script berhenti (Ctrl+C, exit, kill)
trap 'stop_all' EXIT INT TERM

# --------------------------------------------------------------------------- #
# Helpers
# --------------------------------------------------------------------------- #

log()  { echo -e "$*"; }
die()  { log "ERROR: $*" >&2; exit 1; }

is_running() { # $1 = pidfile
  local pid
  [ -f "$1" ] || return 1
  pid="$(cat "$1" 2>/dev/null || true)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

backend_pid()  { is_running "$BACKEND_PID_FILE"  && cat "$BACKEND_PID_FILE"  || true; }
frontend_pid() { is_running "$FRONTEND_PID_FILE" && cat "$FRONTEND_PID_FILE" || true; }

stop_all() {
  local bp fp
  bp="$(backend_pid)";  fp="$(frontend_pid)"
  # Kill process group (setsid) jika ada, fallback kill PID langsung
  [ -n "$bp" ] && { kill -- "-$bp" 2>/dev/null || kill "$bp" 2>/dev/null || true; }
  [ -n "$fp" ] && { kill -- "-$fp" 2>/dev/null || kill "$fp" 2>/dev/null || true; }
  # Kill orphan uvicorn/vite dari project ini
  pkill -f "uvicorn app.main:app" 2>/dev/null || true
  pkill -f "vite.*--host $APP_HOST" 2>/dev/null || true
  rm -f "$BACKEND_PID_FILE" "$FRONTEND_PID_FILE"
}

# --------------------------------------------------------------------------- #
# Commands
# --------------------------------------------------------------------------- #

cmd_start() {
  if is_running "$BACKEND_PID_FILE" || is_running "$FRONTEND_PID_FILE"; then
    log "ClientRadar sudah berjalan. Gunakan: clientradar status / restart"
    return 0
  fi

  # Dependency check
  [ -x "$PROJECT_DIR/venv/bin/python3" ] || die "venv tidak ditemukan. Jalankan: python3 -m venv venv && venv/bin/pip install -r server/requirements.txt"
  [ -d "$PROJECT_DIR/client/node_modules" ] || die "node_modules tidak ditemukan. Jalankan: npm ci --prefix client"

  log "⚡ Starting ClientRadar by Gustiakmal..."

  # Backend — setsid + exec: PID file = process group leader, kill -- -PID membunuh semua child
  setsid bash -c "cd '$PROJECT_DIR/server' && exec '$PROJECT_DIR/venv/bin/python3' -m uvicorn app.main:app --host '$APP_HOST' --port '$BACKEND_PORT' >'$LOG_DIR/backend.log' 2>&1" &
  echo $! > "$BACKEND_PID_FILE"

  # Frontend — setsid + exec npm (vite child ikut dalam process group)
  setsid bash -c "cd '$PROJECT_DIR/client' && exec npm run dev -- --host '$APP_HOST' --strictPort >'$LOG_DIR/frontend.log' 2>&1" &
  echo $! > "$FRONTEND_PID_FILE"

  # Wait for backend to be ready (max 15s)
  local i
  for i in $(seq 1 15); do
    if curl -sf "http://$APP_HOST:$BACKEND_PORT/api/health" >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done

  # Wait for frontend to be ready (max 20s)
  for i in $(seq 1 20); do
    if curl -sf "http://$APP_HOST:$FRONTEND_PORT" >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done

  if ! is_running "$BACKEND_PID_FILE"; then
    log "Gagal menjalankan backend. Lihat log: $LOG_DIR/backend.log"
    stop_all
    exit 1
  fi

  log ""
  log "=========================================================="
  log "  ClientRadar is running successfully!"
  log "  Frontend UI:  http://localhost:$FRONTEND_PORT"
  log "  Backend API:  http://localhost:$BACKEND_PORT"
  log "  API Docs:     http://localhost:$BACKEND_PORT/docs"
  log "  Geo Locate:   http://localhost:$BACKEND_PORT/api/geo/locate"
  log "  Author:       Gustiakmal"
  log "=========================================================="
  log "  Logs: $LOG_DIR/"
  log "  Stop: clientradar stop"
  log ""

  # Open browser (best-effort) — setsid agar tidak ikut mati saat script exit
  if command -v xdg-open >/dev/null 2>&1; then
    setsid nohup xdg-open "http://localhost:$FRONTEND_PORT" >/dev/null 2>&1 &
    disown 2>/dev/null || true
  fi
}

cmd_stop() {
  if ! is_running "$BACKEND_PID_FILE" && ! is_running "$FRONTEND_PID_FILE"; then
    log "ClientRadar tidak berjalan."
    return 0
  fi
  stop_all
  log "ClientRadar stopped."
}

cmd_status() {
  local bp fp
  bp="$(backend_pid)"; fp="$(frontend_pid)"
  if [ -n "$bp" ] || [ -n "$fp" ]; then
    log "ClientRadar: RUNNING"
    [ -n "$bp" ] && log "  Backend  PID $bp  -> http://localhost:$BACKEND_PORT  (health: $(curl -sf "http://$APP_HOST:$BACKEND_PORT/api/health" >/dev/null 2>&1 && echo OK || echo DOWN))"
    [ -n "$fp" ] && log "  Frontend PID $fp -> http://localhost:$FRONTEND_PORT"
  else
    log "ClientRadar: STOPPED"
  fi
}

cmd_gui() {
  # Mode desktop: start + buka browser + tetap jalan (terminal tidak menutup)
  cmd_start
  log "Tekan Ctrl+C untuk menghentikan ClientRadar."
  wait
}

cmd_restart() {
  cmd_stop
  sleep 1
  cmd_start
}

cmd_uninstall() {
  cmd_stop
  local bin_link="$HOME/.local/bin/clientradar"
  local desktop_file="$HOME/.local/share/applications/clientradar.desktop"
  rm -f "$bin_link" "$desktop_file"
  log "Launcher dihapus: $bin_link, $desktop_file"
  log "Project tetap utuh di: $PROJECT_DIR"
}

cmd_install() {
  # Symlink ke ~/.local/bin
  mkdir -p "$HOME/.local/bin"
  ln -sf "$PROJECT_DIR/clientradar" "$HOME/.local/bin/clientradar"

  # Desktop entry
  mkdir -p "$HOME/.local/share/applications"
  cat > "$HOME/.local/share/applications/clientradar.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=ClientRadar
Comment=Developer Prospecting & Web Audit Engine — Gustiakmal
Exec=$PROJECT_DIR/clientradar gui
Icon=$PROJECT_DIR/assets/clientradar.svg
Terminal=true
Categories=Development;Network;
Keywords=client;prospecting;audit;scraping;osm;
EOF

  # Copy desktop shortcut ke Desktop (jika ada)
  if [ -d "$HOME/Desktop" ]; then
    cp "$HOME/.local/share/applications/clientradar.desktop" "$HOME/Desktop/clientradar.desktop"
    chmod +x "$HOME/Desktop/clientradar.desktop"
    # GNOME may need trust
    gio set "$HOME/Desktop/clientradar.desktop" metadata::trusted true 2>/dev/null || true
  fi

  log "Installed:"
  log "  - ~/.local/bin/clientradar  (jalankan dari terminal: clientradar start)"
  log "  - Desktop shortcut: clientradar.desktop"
  log "  - Aplikasi menu: ClientRadar"
}

# --------------------------------------------------------------------------- #
# Main
# --------------------------------------------------------------------------- #

case "${1:-start}" in
  start)     cmd_start ;;
  gui)       cmd_gui ;;
  stop)      cmd_stop ;;
  status)    cmd_status ;;
  restart)   cmd_restart ;;
  install)   cmd_install ;;
  uninstall) cmd_uninstall ;;
  *)         log "Usage: clientradar {start|gui|stop|status|restart|install|uninstall}" ;;
esac